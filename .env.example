# Cloudinary — powers the /realisations portfolio page.
# Get these from your Cloudinary dashboard (Settings → API Keys).
# On Netlify, set the same three as environment variables (Site settings → Environment variables).
# Until these are set, /api/realisations falls back to the local demo images.
NUXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NUXT_CLOUDINARY_API_KEY=
NUXT_CLOUDINARY_API_SECRET=
